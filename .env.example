# API Configuration
# 
# Copy this file to .env.local and update with your values
# .env.local is gitignored and won't be committed

# API Base URL (for production/Vercel)
# Leave empty for local development (uses Vite proxy)
# Example for production: https://api.yourdomain.com
VITE_API_BASE_URL=

# API Proxy Target (for local development only)
# Only used by Vite dev server proxy
# Default: http://127.0.0.1:8000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
